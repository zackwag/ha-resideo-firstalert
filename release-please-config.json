{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "refactor",
      "section": "Code Refactoring"
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores"
    }
  ],
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/resideo_firstalert/manifest.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
